{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "opengl-ui",
  "version-semver": "0.1.0",
  "description": "C++17 OpenGL UI framework with 50+ layui-styled widgets (core/gl/ui/media layers)",
  "homepage": "https://github.com/user/opengl_ui",
  "license": "MIT",
  "supports": "windows",
  "dependencies": [
    {
      "name": "glfw3",
      "version>=": "3.4"
    },
    {
      "name": "glad",
      "version>=": "2.0"
    },
    {
      "name": "stb",
      "version>=": "0"
    }
  ],
  "default-features": [],
  "features": {
    "ffmpeg": {
      "description": "FFmpeg media module (video/audio decode)",
      "dependencies": [
        {
          "name": "ffmpeg",
          "version>=": "5.1"
        }
      ]
    },
    "opencv": {
      "description": "OpenCV media module (image processing)",
      "dependencies": [
        {
          "name": "opencv",
          "version>=": "4.5"
        }
      ]
    }
  }
}
